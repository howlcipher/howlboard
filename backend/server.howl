(http_server 8080
  (defun set_cors (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS, PUT, DELETE")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
    )
  )

  (defun next_task_id ()
    (do
      (store_open kv "memory://howlboard")
      (let (rec (store_get kv "next_id"))
        (let (n 1)
          (do
            (if (is_nil rec)
              (set n 1)
              (let (v (map_get rec "val"))
                (set n (to_int v))
              )
            )
            (store_put kv "next_id" (dict ("val" (to_string (+ n 1)))))
            (return (to_string n))
          )
        )
      )
    )
  )

  (defun can_transition (from to)
    (type_hint from "string")
    (type_hint to "string")
    (type_hint return "bool")
    (if (= from to)
      (return true)
      (if (= from "BACKLOG")
        (if (= to "READY") (return true) (return false))
        (if (= from "READY")
          (if (= to "IN_PROGRESS") (return true) (return false))
          (if (= from "IN_PROGRESS")
            (if (= to "BLOCKED")
              (return true)
              (if (= to "DONE") (return true) (return false))
            )
            (if (= from "BLOCKED")
              (if (= to "IN_PROGRESS") (return true) (return false))
              (if (= from "DONE")
                (if (= to "IN_PROGRESS") (return true) (return false))
                (return false)
              )
            )
          )
        )
      )
    )
  )

  (route "/api/tasks" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (do
          (store_open kv "memory://howlboard")
          (let (next_rec (store_get kv "next_id"))
            (let (max_id 1)
              (do
                (if (is_nil next_rec)
                  (set max_id 1)
                  (let (v (map_get next_rec "val"))
                    (set max_id (to_int v))
                  )
                )
                (let (tasks (list))
                  (let (curr 1)
                    (do
                      (while (< curr max_id)
                        (do
                          (let (t (store_get kv (to_string curr)))
                            (if (is_nil t)
                              (do)
                              (append tasks t)
                            )
                          )
                          (set curr (+ curr 1))
                        )
                      )
                      (res_json 200 (dict ("tasks" tasks)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/create" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (try_let (body (parse_json TaskInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (title (map_get body "title"))
            (if (= title "")
              (res_json 400 (dict ("error" "title_required")))
              (let (desc (map_get body "description"))
                (let (prio (map_get body "priority"))
                  (let (tags (map_get body "tags"))
                    (let (id (call next_task_id))
                      (let (task (dict ("id" id) ("title" title) ("description" desc) ("priority" prio) ("tags" tags) ("status" "BACKLOG")))
                        (do
                          (store_open kv "memory://howlboard")
                          (store_put kv id task)
                          (res_json 201 task)
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/get" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (try_let (body (parse_json TaskInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (= id "")
              (res_json 400 (dict ("error" "id_required")))
              (do
                (store_open kv "memory://howlboard")
                (let (task (store_get kv id))
                  (if (is_nil task)
                    (res_json 404 (dict ("error" "not_found")))
                    (res_json 200 task)
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/update" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (try_let (body (parse_json TaskInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (= id "")
              (res_json 400 (dict ("error" "id_required")))
              (do
                (store_open kv "memory://howlboard")
                (let (task (store_get kv id))
                  (if (is_nil task)
                    (res_json 404 (dict ("error" "not_found")))
                    (let (title (map_get body "title"))
                      (let (desc (map_get body "description"))
                        (let (prio (map_get body "priority"))
                          (let (tags (map_get body "tags"))
                            (let (status (map_get task "status"))
                              (let (updated (dict ("id" id) ("title" title) ("description" desc) ("priority" prio) ("tags" tags) ("status" status)))
                                (do
                                  (store_put kv id updated)
                                  (res_json 200 updated)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/status" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (try_let (body (parse_json TaskInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (= id "")
              (res_json 400 (dict ("error" "id_required")))
              (let (new_status (map_get body "status"))
                (if (= new_status "")
                  (res_json 400 (dict ("error" "status_required")))
                  (do
                    (store_open kv "memory://howlboard")
                    (let (task (store_get kv id))
                      (if (is_nil task)
                        (res_json 404 (dict ("error" "not_found")))
                        (let (curr_status (map_get task "status"))
                          (if (call can_transition curr_status new_status)
                            (let (title (map_get task "title"))
                              (let (desc (map_get task "description"))
                                (let (prio (map_get task "priority"))
                                  (let (tags (map_get task "tags"))
                                    (let (updated (dict ("id" id) ("title" title) ("description" desc) ("priority" prio) ("tags" tags) ("status" new_status)))
                                      (do
                                        (store_put kv id updated)
                                        (res_json 200 updated)
                                      )
                                    )
                                  )
                                )
                              )
                            )
                            (res_json 403 (dict ("error" (+ "invalid_transition_from_" (+ curr_status (+ "_to_" new_status))))))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/delete" (lambda (req)
    (do
      (call set_cors req)
      (if (= (req_method req) "OPTIONS")
        (res_json 204 (dict))
        (try_let (body (parse_json TaskInput req.body))
          (catch parse_err
            (res_json 400 (dict ("error" "invalid_json")))
          )
          (let (id (map_get body "id"))
            (if (= id "")
              (res_json 400 (dict ("error" "id_required")))
              (do
                (store_open kv "memory://howlboard")
                (let (task (store_get kv id))
                  (if (is_nil task)
                    (res_json 404 (dict ("error" "not_found")))
                    (do
                      (store_delete kv id)
                      (res_json 200 (dict ("deleted" id)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))
)
