(http_server 8080
  (defun next_task_id ()
    (do
      (store_open tasks "memory://howlboard")
      (let (next (store_get tasks "next_id"))
        (let (id 3)
          (do
            (if (is_nil next)
              (set id 3)
              (let (value (map_get next "value"))
                (set id (to_int value))
              )
            )
            (store_put tasks "next_id" (dict ("value" (to_string (+ id 1)))))
            (return (to_string id))
          )
        )
      )
    )
  )

  (route "/api/tasks" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("ok" "true")))
        (if (= (req_method req) "GET")
          (do
            (store_open tasks "memory://howlboard")
            (let (next (store_get tasks "next_id"))
              (do
                (if (is_nil next)
                  (do
                    (store_put tasks "1" (dict ("id" "1") ("title" "Learn HowlFrame") ("status" "open")))
                    (store_put tasks "2" (dict ("id" "2") ("title" "Build HowlBoard") ("status" "open")))
                    (store_put tasks "next_id" (dict ("value" "3")))
                  )
                )
                (let (tasks_list (list))
                  (let (current 1)
                    (let (limit (store_get tasks "next_id"))
                      (let (max_id (to_int (map_get limit "value")))
                        (do
                          (while (< current max_id)
                            (do
                              (let (task (store_get tasks (to_string current)))
                                (if (is_nil task)
                                  (do)
                                  (append tasks_list task)
                                )
                              )
                              (set current (+ current 1))
                            )
                          )
                          (res_json 200 (dict ("tasks" tasks_list)))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          (if (= (req_method req) "POST")
            (try_let (body (parse_json TaskInput req.body))
              (catch parse_error
                (res_json 400 (dict ("error" "invalid_json")))
              )
              (let (title (map_get body "title"))
                (if (= title "")
                  (res_json 400 (dict ("error" "title_required")))
                  (let (id (call next_task_id))
                    (let (task (dict ("id" id) ("title" title) ("status" "open")))
                      (do
                        (store_open tasks "memory://howlboard")
                        (store_put tasks id task)
                        (res_json 201 task)
                      )
                    )
                  )
                )
              )
            )
            (res_json 405 (dict ("error" "method_not_allowed")))
          )
        )
      )
    )
  ))

  (route "/api/tasks/complete" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "POST, OPTIONS")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("ok" "true")))
        (if (= (req_method req) "POST")
          (try_let (body (parse_json TaskInput req.body))
            (catch parse_error
              (res_json 400 (dict ("error" "invalid_json")))
            )
            (let (id (map_get body "id"))
              (if (= id "")
                (res_json 400 (dict ("error" "id_required")))
                (do
                  (store_open tasks "memory://howlboard")
                  (let (task (store_get tasks id))
                    (if (is_nil task)
                      (res_json 404 (dict ("error" "not_found")))
                      (let (title (map_get task "title"))
                        (let (updated (dict ("id" id) ("title" title) ("status" "done")))
                          (do
                            (store_put tasks id updated)
                            (res_json 200 updated)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          (res_json 405 (dict ("error" "method_not_allowed")))
        )
      )
    )
  ))
)
