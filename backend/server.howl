(http_server 8080
  (defun log_activity (task_id from to)
    (do
      (store_open act "file://howlboard_activity.json")
      (let (rec (store_get act "list"))
        (let (activities (list))
          (do
            (if (is_nil rec)
              (do)
              (set activities (map_get rec "activities"))
            )
            (append activities (dict ("task_id" task_id) ("from" from) ("to" to) ("timestamp" (to_string (time_now)))))
            (store_put act "list" (dict ("activities" activities)))
          )
        )
      )
    )
  )

  (defun next_task_id ()
    (do
      (store_open kv "file://howlboard.json")
      (let (seq_rec (store_get kv "_seq"))
        (if (is_nil seq_rec)
          (do
            (store_put kv "_seq" (dict ("val" 1)))
            (return "1")
          )
          (let (next (+ (map_get seq_rec "val") 1))
            (do
              (store_put kv "_seq" (dict ("val" next)))
              (return (to_string next))
            )
          )
        )
      )
    )
  )

  (route "/api/tasks" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (do
          (store_open kv "file://howlboard.json")
          (let (tasks (list))
            (let (all_ids_rec (store_get kv "_all_ids"))
              (do
                (if (is_nil all_ids_rec)
                  (do)
                  (let (ids (map_get all_ids_rec "ids"))
                    (for id ids
                      (let (task (store_get kv id))
                        (if (is_nil task)
                          (do)
                          (append tasks task)
                        )
                      )
                    )
                  )
                )
                (res_json 200 (dict ("tasks" tasks)))
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/activity" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (do
          (store_open act "file://howlboard_activity.json")
          (let (rec (store_get act "list"))
            (if (is_nil rec)
              (res_json 200 (dict ("activities" (list))))
              (res_json 200 rec)
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/create" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err
            (res_json 400 (dict ("error" "INVALID_JSON") ("message" "Invalid JSON in request body")))
          )
          (let (title (to_string (map_get body "title")))
            (let (desc (to_string (map_get body "description")))
              (let (prio (to_string (map_get body "priority")))
                (let (labels (to_string (map_get body "labels")))
                  (if (= title "")
                    (res_json 400 (dict ("error" "MISSING_FIELD") ("field" "title")))
                    (do
                      (if (= prio "") (set prio "NORMAL") (do))
                      (if (and (!= prio "LOW") (and (!= prio "NORMAL") (!= prio "HIGH")))
                        (res_json 400 (dict ("error" "INVALID_PRIORITY") ("valid" "LOW, NORMAL, HIGH")))
                        (let (id (call next_task_id))
                          (let (now (to_string (time_now)))
                            (let (task (dict ("id" id) ("title" title) ("description" desc) ("priority" prio) ("labels" labels) ("status" "BACKLOG") ("created_at" now) ("updated_at" now)))
                              (do
                                (store_open kv "file://howlboard.json")
                                (store_put kv id task)
                                (let (all_ids_rec (store_get kv "_all_ids"))
                                  (if (is_nil all_ids_rec)
                                    (store_put kv "_all_ids" (dict ("ids" (list id))))
                                    (let (ids (map_get all_ids_rec "ids"))
                                      (do
                                        (append ids id)
                                        (store_put kv "_all_ids" (dict ("ids" ids)))
                                      )
                                    )
                                  )
                                )
                                (call log_activity id "" "BACKLOG")
                                (res_json 201 task)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/status" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err
            (res_json 400 (dict ("error" "INVALID_JSON")))
          )
          (let (id (to_string (map_get body "id")))
            (let (new_status (to_string (map_get body "status")))
              (if (or (= id "") (= new_status ""))
                (res_json 400 (dict ("error" "MISSING_FIELD")))
                (do
                  (store_open kv "file://howlboard.json")
                  (let (task (store_get kv id))
                    (if (is_nil task)
                      (res_json 404 (dict ("error" "TASK_NOT_FOUND") ("id" id)))
                      (let (curr_status (map_get task "status"))
                        (if (= curr_status new_status)
                          (res_json 200 task)
                          (let (valid (= "" "not-valid"))
                            (do
                              (if (and (= curr_status "BACKLOG") (= new_status "READY")) (set valid (= "valid" "valid")) (do))
                              (if (and (= curr_status "READY") (= new_status "IN_PROGRESS")) (set valid (= "valid" "valid")) (do))
                              (if (and (= curr_status "IN_PROGRESS") (= new_status "BLOCKED")) (set valid (= "valid" "valid")) (do))
                              (if (and (= curr_status "IN_PROGRESS") (= new_status "DONE")) (set valid (= "valid" "valid")) (do))
                              (if (and (= curr_status "BLOCKED") (= new_status "IN_PROGRESS")) (set valid (= "valid" "valid")) (do))
                              (if (and (= curr_status "DONE") (= new_status "IN_PROGRESS")) (set valid (= "valid" "valid")) (do))
                              (if valid
                                (do
                                  (map_set task "status" new_status)
                                  (map_set task "updated_at" (to_string (time_now)))
                                  (store_put kv id task)
                                  (call log_activity id curr_status new_status)
                                  (res_json 200 task)
                                )
                                (res_json 400 (dict ("error" "INVALID_TRANSITION") ("from" curr_status) ("to" new_status)))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/tasks/delete" (lambda (req)
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err
            (res_json 400 (dict ("error" "INVALID_JSON")))
          )
          (let (id (to_string (map_get body "id")))
            (if (= id "")
              (res_json 400 (dict ("error" "MISSING_FIELD")))
              (do
                (store_open kv "file://howlboard.json")
                (let (task (store_get kv id))
                  (if (is_nil task)
                    (res_json 404 (dict ("error" "TASK_NOT_FOUND")))
                    (do
                      (store_delete kv id)
                      (let (all_ids_rec (store_get kv "_all_ids"))
                        (if (is_nil all_ids_rec)
                          (do)
                          (let (ids (map_get all_ids_rec "ids"))
                            (let (new_ids (list))
                              (do
                                (for i ids
                                  (if (= i id) (do) (append new_ids i))
                                )
                                (store_put kv "_all_ids" (dict ("ids" new_ids)))
                              )
                            )
                          )
                        )
                      )
                      (call log_activity id (map_get task "status") "DELETED")
                      (res_json 200 (dict ("status" "deleted")))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))
)
