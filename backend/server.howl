; HowlBoard v0.1 backend - AI engineering mission control.
;
; Runs as standalone HowlFrame bytecode under the VM with explicit capability
; grants (network, database, filesystem). Every domain term here comes from an
; existing Howl ecosystem schema rather than a parallel vocabulary:
;
;   authority.decision        HowlChangeOps Decision.Result
;   authority.envelope_status HowlPlane AuthorityDecision
;   authority.gates           HowlChangeOps Gate
;   evidence[].type           HowlRelay EvidenceType
;   verification[]            HowlChangeOps ValidationResult
;   execution.receipt         HowlChangeOps ExecutionReceipt
;   timeline[].action         HowlPlane evidence_ledger ai.evidence_entry/v1
;   factory status            HowlPlane howlplane.factory.status/v1
;                             Plane artifact factory/status/remote-snapshot.json
;   pending backlog row       HowlPlane BacklogSource exact Pending row
;
; Factory routes are a projection and a paste preview. They do not start a
; supervisor, take a lock, write a queue, or accept owner_direction.
;
; The bytecode target has no module system, so this is deliberately one file.

(http_server 8080

  ; ---------------------------------------------------------------- helpers

  ; Response headers set inside a defun apply to the calling request. The
  ; request environment is the parent of the call environment, so the response
  ; writer resolves correctly.
  (defun cors ()
    (do
      (res_header "Access-Control-Allow-Origin" "*")
      (res_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS")
      (res_header "Access-Control-Allow-Headers" "Content-Type")
    )
  )

  (defun next_seq (counter_key)
    (do
      (store_open kv "file://howlboard_missions.json")
      (let (rec (store_get kv counter_key))
        (if (is_nil rec)
          (do
            (store_put kv counter_key (dict ("val" 1)))
            (return "1")
          )
          (let (next (+ (map_get rec "val") 1))
            (do
              (store_put kv counter_key (dict ("val" next)))
              (return (to_string next))
            )
          )
        )
      )
    )
  )

  ; Append-only audit feed. A single ordered list is the source of truth for
  ; both the dashboard feed and per-mission history; the language has no sort
  ; primitive, so insertion order is the only ordering available.
  (defun log_event (mission_id action actor detail)
    (do
      (store_open tl "file://howlboard_timeline.json")
      (let (rec (store_get tl "feed"))
        (let (events (list))
          (do
            (if (is_nil rec) (do) (set events (map_get rec "events")))
            (append events (dict
              ("mission_id" mission_id)
              ("action" action)
              ("actor" actor)
              ("detail" detail)
              ("timestamp" (time_now))))
            (store_put tl "feed" (dict ("events" events)))
          )
        )
      )
    )
  )

  ; Mission state machine. Explicit whitelist; everything absent is rejected.
  (defun can_transition (from to)
    (type_hint return "bool")
    (let (ok false)
      (do
        (if (and (= from "CREATED") (= to "ROUTED")) (set ok true) (do))
        (if (and (= from "ROUTED") (= to "EXECUTING")) (set ok true) (do))
        (if (and (= from "ROUTED") (= to "AWAITING_APPROVAL")) (set ok true) (do))
        (if (and (= from "AWAITING_APPROVAL") (= to "EXECUTING")) (set ok true) (do))
        (if (and (= from "AWAITING_APPROVAL") (= to "CLOSED")) (set ok true) (do))
        (if (and (= from "EXECUTING") (= to "VERIFYING")) (set ok true) (do))
        (if (and (= from "EXECUTING") (= to "BLOCKED")) (set ok true) (do))
        (if (and (= from "EXECUTING") (= to "FAILED")) (set ok true) (do))
        (if (and (= from "VERIFYING") (= to "COMPLETED")) (set ok true) (do))
        (if (and (= from "VERIFYING") (= to "REMEDIATING")) (set ok true) (do))
        (if (and (= from "VERIFYING") (= to "FAILED")) (set ok true) (do))
        (if (and (= from "REMEDIATING") (= to "EXECUTING")) (set ok true) (do))
        (if (and (= from "REMEDIATING") (= to "FAILED")) (set ok true) (do))
        (if (and (= from "BLOCKED") (= to "EXECUTING")) (set ok true) (do))
        (if (and (= from "BLOCKED") (= to "CLOSED")) (set ok true) (do))
        (if (and (= from "FAILED") (= to "REMEDIATING")) (set ok true) (do))
        (if (and (= from "FAILED") (= to "CLOSED")) (set ok true) (do))
        (return ok)
      )
    )
  )

  ; Authority is derived on every read, never trusted from storage. An approval
  ; that was valid when written must present as ENVELOPE_EXPIRED once it lapses.
  (defun envelope_status (mission)
    (type_hint mission "dict")
    (let (status "ENVELOPE_ABSENT")
      (do
        (let (auth (map_get mission "authority"))
          (if (= auth "")
            (do)
            (let (decision (to_string (map_get auth "decision")))
              (let (approval (map_get auth "approval"))
                (do
                  (if (= decision "ALLOW") (set status "DELEGATED_AUTHORITY_ALLOW") (do))
                  (if (= decision "DENY") (set status "DENIED_BY_ENVELOPE") (do))
                  (if (= approval "")
                    (do)
                    (let (expires (to_int (map_get approval "expires_at")))
                      (if (< expires (time_now))
                        (set status "ENVELOPE_EXPIRED")
                        (if (= decision "DENY")
                          (set status "DENIED_BY_ENVELOPE")
                          (set status "DELEGATED_AUTHORITY_ALLOW"))
                      )
                    )
                  )
                )
              )
            )
          )
        )
        (return status)
      )
    )
  )

  ; store_keys removes the hand-maintained index record every earlier HowlFrame
  ; application needed. Keys are returned sorted, so listing is deterministic.
  (defun all_missions ()
    (type_hint return "list")
    (do
      (store_open kv "file://howlboard_missions.json")
      (let (out (list))
        (do
          (for k (store_keys kv)
            (let (parts (str_split k ":"))
              (let (head (list_get parts 0))
                (if (= head "mission")
                  (let (m (store_get kv k))
                    (if (is_nil m) (do) (append out m))
                  )
                  (do)
                )
              )
            )
          )
          (return out)
        )
      )
    )
  )

  (defun mission_summary (m)
    (type_hint m "dict")
    (type_hint return "dict")
    (return (dict
      ("id" (map_get m "id"))
      ("title" (map_get m "title"))
      ("project" (map_get m "project"))
      ("state" (map_get m "state"))
      ("priority" (map_get m "priority"))
      ("risk_level" (map_get m "risk_level"))
      ("executor" (map_get m "executor"))
      ("outcome" (map_get m "outcome"))
      ("provenance" (map_get m "provenance"))
      ("envelope_status" (call envelope_status m))
      ("updated_at" (map_get m "updated_at"))))
  )


  ; Optional depends_on: list of mission ID strings. Omitted or [] means none.
  ; Fail-closed on non-list values and non-string elements. Informational only —
  ; not ordering, authority, scheduling, or completion gates.
  (defun validate_depends_on (raw)
    (type_hint return "dict")
    (if (= (to_string raw) "")
      (return (dict ("ok" "true") ("deps" (list))))
      (try_let (n (list_len raw))
        (catch err (return (dict
          ("ok" "false")
          ("error" "INVALID_DEPENDS_ON")
          ("reason" "not_a_list"))))
        (let (out (list))
          (let (bad "false")
            (do
              (for el raw
                (if (= el (to_string el))
                  (append out (to_string el))
                  (set bad "true")
                )
              )
              (if (= bad "true")
                (return (dict
                  ("ok" "false")
                  ("error" "INVALID_DEPENDS_ON")
                  ("reason" "non_string_element")))
                (return (dict ("ok" "true") ("deps" out)))
              )
            )
          )
        )
      )
    )
  )

  ; ------------------------------------------------------- factory projection
  ;
  ; Reads a redacted howlplane.factory.status/v1 document. The Plane artifact
  ; is factory/status/remote-snapshot.json. Until the host publishes it, the
  ; Board drop at data/factory/status/remote-snapshot.json is absent and the
  ; response says so. A fixture at data/fixtures/factory/remote-snapshot.json
  ; is opt-in via {"source":"fixture"} and is labelled FIXTURE.

  (defun contains (haystack needle)
    (type_hint return "bool")
    (let (parts (str_split (to_string haystack) (to_string needle)))
      (return (> (list_len parts) 1))
    )
  )

  (defun plain (v)
    (let (s (to_string v))
      (let (out "")
        (do
          (if (and (!= s "") (!= s "<nil>")) (set out s) (do))
          (return out)
        )
      )
    )
  )

  (defun is_true (v)
    (type_hint return "bool")
    (return (= (to_string v) "true"))
  )

  (defun looks_secret (s)
    (type_hint return "bool")
    (let (hit false)
      (do
        (if (call contains s "ghp_") (set hit true) (do))
        (if (call contains s "gho_") (set hit true) (do))
        (if (call contains s "ghu_") (set hit true) (do))
        (if (call contains s "ghs_") (set hit true) (do))
        (if (call contains s "ghr_") (set hit true) (do))
        (if (call contains s "github_pat_") (set hit true) (do))
        (if (call contains s "sk-") (set hit true) (do))
        (if (call contains s "Bearer ") (set hit true) (do))
        (if (call contains s "AKIA") (set hit true) (do))
        (if (call contains s "xox") (set hit true) (do))
        (return hit)
      )
    )
  )

  ; Board is a reader. Unknown fields are dropped by the projection. Free text
  ; that still carries an obvious token is replaced wholesale.
  (defun scrub (s)
    (let (out s)
      (do
        (if (= s "") (do) (if (call looks_secret s) (set out "[redacted]") (do)))
        (return out)
      )
    )
  )

  (defun status_projection_path (source)
    (let (path "")
      (do
        (if (= source "published") (set path "data/factory/status/remote-snapshot.json") (do))
        (if (= source "fixture") (set path "data/fixtures/factory/remote-snapshot.json") (do))
        (return path)
      )
    )
  )

  (defun absent_status (reason provenance path)
    (type_hint return "dict")
    (return (dict
      ("present" "false")
      ("schema" "howlplane.factory.status/v1")
      ("artifact" "factory/status/remote-snapshot.json")
      ("projection_path" path)
      ("provenance" provenance)
      ("reason" reason)
      ("redacted" "false")
      ("state" "unknown")
      ("current_dispatch" "")
      ("owner_required" "false")
      ("blockers" (list))
      ("campaign_id" "")
      ("mission_campaign_id" "")
      ("repository" "")
      ("published_at" "")
      ("last_tick_at" "")
      ("last_successful_tick_at" "")
      ("last_error" "")
      ("failure_count" 0)
      ("current_work_item_id" "")
      ("stopped_reason" "")
      ("objective" "")
      ("target_mode" "")
      ("run_mode" "")
      ("authority" "")))
  )

  (defun project_blocker (item)
    (type_hint item "dict")
    (type_hint return "dict")
    (return (dict
      ("class" (call scrub (call plain (map_get item "class"))))
      ("work_item_id" (call scrub (call plain (map_get item "work_item_id"))))
      ("state" (call scrub (call plain (map_get item "state"))))
      ("summary" (call scrub (call plain (map_get item "summary"))))
      ("proposal_id" (call scrub (call plain (map_get item "proposal_id"))))))
  )

  (defun any_owner (blockers)
    (type_hint blockers "list")
    (let (hit "false")
      (do
        (for b blockers
          (if (= (map_get b "class") "OWNER_REQUIRED") (set hit "true") (do))
        )
        (return hit)
      )
    )
  )

  (defun project_redacted (doc path source)
    (type_hint doc "dict")
    (type_hint return "dict")
    (let (blockers (list))
      (let (raw (map_get doc "blockers"))
        (let (n 0)
          (let (provenance "PUBLISHED")
            (do
              (if (= source "fixture") (set provenance "FIXTURE") (do))
              (if (or (= (to_string raw) "") (= (to_string raw) "<nil>"))
                (do)
                (try_let (blen (list_len raw))
                  (catch err (do))
                  (for item raw
                    (if (< n 40)
                      (try_let (probe (map_get item "class"))
                        (catch berr (do))
                        (do
                          (append blockers (call project_blocker item))
                          (set n (+ n 1))
                        )
                      )
                      (do)
                    )
                  )
                )
              )
              (let (state (call scrub (call plain (map_get doc "state"))))
                (let (dispatch (call scrub (call plain (map_get doc "current_dispatch"))))
                  (let (owner "false")
                    (do
                      (if (= state "") (set state "unknown") (do))
                      (if (= dispatch "") (set dispatch "idle") (do))
                      (if (call is_true (map_get doc "owner_required")) (set owner "true") (do))
                      (if (= (call any_owner blockers) "true") (set owner "true") (do))
                      (return (dict
                        ("present" "true")
                        ("schema" "howlplane.factory.status/v1")
                        ("artifact" "factory/status/remote-snapshot.json")
                        ("projection_path" path)
                        ("provenance" provenance)
                        ("reason" "")
                        ("redacted" "true")
                        ("published_at" (call scrub (call plain (map_get doc "published_at"))))
                        ("campaign_id" (call scrub (call plain (map_get doc "campaign_id"))))
                        ("mission_campaign_id" (call scrub (call plain (map_get doc "mission_campaign_id"))))
                        ("repository" (call scrub (call plain (map_get doc "repository"))))
                        ("state" state)
                        ("current_dispatch" dispatch)
                        ("current_work_item_id" (call scrub (call plain (map_get doc "current_work_item_id"))))
                        ("blockers" blockers)
                        ("owner_required" owner)
                        ("last_tick_at" (call scrub (call plain (map_get doc "last_tick_at"))))
                        ("last_successful_tick_at" (call scrub (call plain (map_get doc "last_successful_tick_at"))))
                        ("last_error" (call scrub (call plain (map_get doc "last_error"))))
                        ("failure_count" (to_int (call plain (map_get doc "failure_count"))))
                        ("stopped_reason" (call scrub (call plain (map_get doc "stopped_reason"))))
                        ("objective" (call scrub (call plain (map_get doc "objective"))))
                        ("target_mode" (call scrub (call plain (map_get doc "target_mode"))))
                        ("run_mode" (call scrub (call plain (map_get doc "run_mode"))))
                        ("authority" (call scrub (call plain (map_get doc "authority"))))))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun project_snapshot (doc path source)
    (type_hint doc "dict")
    (type_hint return "dict")
    (let (schema (call plain (map_get doc "schema")))
      (let (out (call absent_status "SCHEMA_MISMATCH" "INVALID" path))
        (do
          (if (!= schema "howlplane.factory.status/v1")
            (do)
            (if (call is_true (map_get doc "redacted"))
              (set out (call project_redacted doc path source))
              (set out (call absent_status "NOT_REDACTED" "INVALID" path))
            )
          )
          (return out)
        )
      )
    )
  )

  (defun serve_factory_status (source)
    (let (normalized source)
      (do
        (if (or (= normalized "") (= normalized "<nil>")) (set normalized "published") (do))
        (let (path (call status_projection_path normalized))
          (if (= path "")
            (res_json 400 (dict
              ("error" "UNKNOWN_SOURCE")
              ("source" source)
              ("valid" "published, fixture")))
            (try_let (probe (read_file "data/fixtures/missions.json"))
              (catch err (res_json 500 (dict
                ("error" "STATUS_UNREADABLE")
                ("reason" "FILESYSTEM_UNAVAILABLE"))))
              (try_let (raw (read_file path))
                (catch missing (res_json 200 (call absent_status "SNAPSHOT_ABSENT" "ABSENT" path)))
                (let (text (bytes_to_string raw))
                  (try_let (doc (parse_json Any text))
                    (catch perr (res_json 200 (call absent_status "SNAPSHOT_INVALID" "INVALID" path)))
                    (res_json 200 (call project_snapshot doc path normalized))
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  ; Exact Pending row for BacklogSource. Status is forced to Pending.
  ; bugs.md and issues.md are bug ledgers; improvements.md is the improvement
  ; ledger. ROI floor 0.5 matches BacklogSource's default. A row below the
  ; floor is still previewed and marked ineligible.

  (defun lower_ascii (s)
    (let (out s)
      (do
        (set out (str_join (str_split out "A") "a"))
        (set out (str_join (str_split out "B") "b"))
        (set out (str_join (str_split out "C") "c"))
        (set out (str_join (str_split out "D") "d"))
        (set out (str_join (str_split out "E") "e"))
        (set out (str_join (str_split out "F") "f"))
        (set out (str_join (str_split out "G") "g"))
        (set out (str_join (str_split out "H") "h"))
        (set out (str_join (str_split out "I") "i"))
        (set out (str_join (str_split out "J") "j"))
        (set out (str_join (str_split out "K") "k"))
        (set out (str_join (str_split out "L") "l"))
        (set out (str_join (str_split out "M") "m"))
        (set out (str_join (str_split out "N") "n"))
        (set out (str_join (str_split out "O") "o"))
        (set out (str_join (str_split out "P") "p"))
        (set out (str_join (str_split out "Q") "q"))
        (set out (str_join (str_split out "R") "r"))
        (set out (str_join (str_split out "S") "s"))
        (set out (str_join (str_split out "T") "t"))
        (set out (str_join (str_split out "U") "u"))
        (set out (str_join (str_split out "V") "v"))
        (set out (str_join (str_split out "W") "w"))
        (set out (str_join (str_split out "X") "x"))
        (set out (str_join (str_split out "Y") "y"))
        (set out (str_join (str_split out "Z") "z"))
        (return out)
      )
    )
  )

  (defun collapse_hyphens (s)
    (let (out s)
      (do
        (while (call contains out "--")
          (set out (str_join (str_split out "--") "-"))
        )
        (return out)
      )
    )
  )

  (defun slug (title)
    (let (out (call lower_ascii title))
      (do
        (set out (str_join (str_split out " ") "-"))
        (set out (call collapse_hyphens out))
        (return out)
      )
    )
  )

  (defun cell_unsafe (s)
    (type_hint return "bool")
    (let (bad false)
      (do
        (if (call contains s "|") (set bad true) (do))
        (if (call contains s "\n") (set bad true) (do))
        (return bad)
      )
    )
  )

  (defun backlog_kind (name)
    (let (kind "")
      (do
        (if (= name "bugs.md") (set kind "bug") (do))
        (if (= name "issues.md") (set kind "bug") (do))
        (if (= name "improvements.md") (set kind "improvement") (do))
        (return kind)
      )
    )
  )

  (defun score_eligible (score)
    (type_hint return "bool")
    (return (>= (to_float score) 0.5))
  )

  (defun blocks_row (reasons)
    (type_hint reasons "list")
    (type_hint return "bool")
    (let (bad false)
      (do
        (for reason reasons
          (if (= reason "BELOW_ROI_FLOOR") (do) (set bad true))
        )
        (return bad)
      )
    )
  )

  (defun pending_detail (item_id title symptom acceptance)
    (let (out "")
      (do
        (if (and (= symptom "") (= acceptance ""))
          (do)
          (do
            (set out (str_join (list "### " item_id ". " title) ""))
            (if (= symptom "")
              (do)
              (set out (str_join (list out "\n\nSymptom: " symptom) ""))
            )
            (if (= acceptance "")
              (do)
              (set out (str_join (list out "\n\nDeterministic acceptance: " acceptance) ""))
            )
          )
        )
        (return out)
      )
    )
  )

  (defun preview_pending_row (body)
    (type_hint body "dict")
    (type_hint return "dict")
    (let (item_id (call plain (map_get body "item_id")))
      (let (title (call plain (map_get body "title")))
        (let (score (call plain (map_get body "score")))
          (let (formula (call plain (map_get body "formula")))
            (let (rationale (call plain (map_get body "rationale")))
              (let (source_file (call plain (map_get body "source_file")))
                (let (symptom (call plain (map_get body "symptom")))
                  (let (acceptance (call plain (map_get body "acceptance")))
                    (let (reasons (list))
                      (let (kind (call backlog_kind source_file))
                        (do
                          (if (regex_match "^[0-9]+$" item_id)
                            (do)
                            (do (append reasons "ITEM_ID_NOT_DIGITS"))
                          )
                          (if (regex_match "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*( [A-Za-z0-9]+(-[A-Za-z0-9]+)*)*$" title)
                            (do)
                            (do (append reasons "TITLE_CHARS"))
                          )
                          (if (regex_match "^[0-9]+(\\.[0-9]+)?$" score)
                            (do)
                            (do (append reasons "SCORE_FORMAT"))
                          )
                          (if (= formula "")
                            (do)
                            (if (regex_match "^[0-9A-Za-z+*/.x-]+$" formula)
                              (do)
                              (do (append reasons "FORMULA_CHARS"))
                            )
                          )
                          (if (= rationale "")
                            (do (append reasons "MISSING_RATIONALE"))
                            (if (call cell_unsafe rationale)
                              (do (append reasons "RATIONALE_UNSAFE"))
                              (do)
                            )
                          )
                          (if (= kind "")
                            (do (append reasons "UNKNOWN_SOURCE_FILE"))
                            (do)
                          )
                          (if (regex_match "^[0-9]+(\\.[0-9]+)?$" score)
                            (if (call score_eligible score)
                              (do)
                              (do (append reasons "BELOW_ROI_FLOOR"))
                            )
                            (do)
                          )
                          (let (row "")
                            (let (detail "")
                              (let (anchor "")
                                (let (score_cell "")
                                  (let (eligible "false")
                                    (let (origin "")
                                      (let (markdown "")
                                        (do
                                          ; list_len is int64 and integer literals are float64, so
                                          ; numeric compare is required. = does not coerce.
                                          (if (<= (list_len reasons) 0)
                                            (do
                                              (set eligible "true")
                                              (set origin "existing_backlog")
                                            )
                                            (do)
                                          )
                                          (if (call blocks_row reasons)
                                            (do)
                                            (do
                                              (set anchor (str_join (list "#" item_id "-" (call slug title)) ""))
                                              (if (= formula "")
                                                (set score_cell score)
                                                (set score_cell (str_join (list score " (" formula ")") ""))
                                              )
                                              (set row (str_join (list
                                                "| " item_id
                                                " | [" title
                                                "](" anchor
                                                ") | Pending | " score_cell
                                                " | " rationale
                                                " |") ""))
                                              (set detail (call pending_detail item_id title symptom acceptance))
                                              (if (= detail "")
                                                (set markdown row)
                                                (set markdown (str_join (list row "\n\n" detail) ""))
                                              )
                                            )
                                          )
                                          (return (dict
                                            ("ok" (if (= row "") "false" "true"))
                                            ("eligible" eligible)
                                            ("origin" origin)
                                            ("backlog_schema" "howlplane.backlog_item/v1")
                                            ("status" "Pending")
                                            ("required_status" "Pending")
                                            ("roi_floor" "0.5")
                                            ("source_file" source_file)
                                            ("kind" kind)
                                            ("item_id" item_id)
                                            ("title" title)
                                            ("anchor" anchor)
                                            ("score" score)
                                            ("score_cell" score_cell)
                                            ("rationale" rationale)
                                            ("row" row)
                                            ("detail" detail)
                                            ("markdown" markdown)
                                            ("table_header" "| # | Title | Status | Score | Rationale |\n| --- | --- | --- | --- | --- |")
                                            ("reasons" reasons)
                                            ("note" "Paste the row under the first ## Ranked Backlog heading in bugs.md, issues.md, or improvements.md at the repository root. BacklogSource admits an exact Pending status at or above ROI 0.5. This preview does not write a queue, does not set owner_direction, and does not start Factory.")))
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  ; ----------------------------------------------------------------- routes

  (route "/api/missions" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (let (out (list))
          (do
            (for m (call all_missions)
              (append out (call mission_summary m))
            )
            (res_json 200 (dict ("missions" out)))
          )
        )
      )
    )
  ))

  (route "/api/missions/get" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (id (to_string (map_get body "id")))
            (if (= id "")
              (res_json 400 (dict ("error" "MISSING_FIELD") ("field" "id")))
              (do
                (store_open kv "file://howlboard_missions.json")
                (let (m (store_get kv (str_join (list "mission:" id) "")))
                  (if (is_nil m)
                    (res_json 404 (dict ("error" "MISSION_NOT_FOUND") ("id" id)))
                    (let (events (list))
                      (do
                        (store_open tl "file://howlboard_timeline.json")
                        (let (rec (store_get tl "feed"))
                          (if (is_nil rec)
                            (do)
                            (for e (map_get rec "events")
                              (if (= (map_get e "mission_id") id) (append events e) (do))
                            )
                          )
                        )
                        (map_set m "envelope_status" (call envelope_status m))
                        (map_set m "timeline" events)
                        (res_json 200 m)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/dashboard" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (let (counts (dict
              ("CREATED" 0) ("ROUTED" 0) ("EXECUTING" 0) ("AWAITING_APPROVAL" 0)
              ("VERIFYING" 0) ("REMEDIATING" 0) ("BLOCKED" 0)
              ("COMPLETED" 0) ("FAILED" 0) ("CLOSED" 0)))
          (let (total 0)
            (let (verification_failures 0)
              (let (expired 0)
                (let (agents (dict))
                  (do
                    (for m (call all_missions)
                      (do
                        (set total (+ total 1))
                        (let (st (to_string (map_get m "state")))
                          (let (prev (map_get counts st))
                            ; counts is int-valued, so absence is tested through
                            ; to_string: a present 0 renders "0", a missing key "".
                            (if (= (to_string prev) "")
                              (map_set counts st 1)
                              (map_set counts st (+ prev 1))
                            )
                          )
                        )
                        (if (= (call envelope_status m) "ENVELOPE_EXPIRED")
                          (set expired (+ expired 1)) (do))
                        (let (vs (map_get m "verification"))
                          (if (= vs "")
                            (do)
                            (for v vs
                              (if (= (map_get v "status") "failed")
                                (set verification_failures (+ verification_failures 1))
                                (do))
                            )
                          )
                        )
                        (let (ex (to_string (map_get m "executor")))
                          (if (= ex "")
                            (do)
                            (let (seen (map_get agents ex))
                              (if (= seen "")
                                (map_set agents ex 1)
                                (map_set agents ex (+ seen 1))
                              )
                            )
                          )
                        )
                      )
                    )
                    (res_json 200 (dict
                      ("total" total)
                      ("counts" counts)
                      ("verification_failures" verification_failures)
                      ("expired_authority" expired)
                      ("agents" agents)))
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/projects" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        ; Returned as a list of records rather than a keyed dict: there is no
        ; map_keys primitive, so a client cannot enumerate a dict's keys.
        (let (names (list))
          (let (counts (dict))
            (do
              (for m (call all_missions)
                (let (p (to_string (map_get m "project")))
                  (if (= p "")
                    (do)
                    (let (n (map_get counts p))
                      (if (= (to_string n) "")
                        (do
                          (map_set counts p 1)
                          (append names p)
                        )
                        (map_set counts p (+ n 1))
                      )
                    )
                  )
                )
              )
              (let (out (list))
                (do
                  (for name names
                    (append out (dict ("name" name) ("count" (map_get counts name))))
                  )
                  (res_json 200 (dict ("projects" out)))
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/timeline" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (do
          (store_open tl "file://howlboard_timeline.json")
          (let (rec (store_get tl "feed"))
            (if (is_nil rec)
              (res_json 200 (dict ("events" (list))))
              (res_json 200 rec)
            )
          )
        )
      )
    )
  ))

  (route "/api/missions/create" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (title (to_string (map_get body "title")))
            (let (project (to_string (map_get body "project")))
              (let (prio (to_string (map_get body "priority")))
                (if (= title "")
                  (res_json 400 (dict ("error" "MISSING_FIELD") ("field" "title")))
                  (if (= project "")
                    (res_json 400 (dict ("error" "MISSING_FIELD") ("field" "project")))
                    (do
                      (if (= prio "") (set prio "NORMAL") (do))
                      (if (and (!= prio "LOW") (and (!= prio "NORMAL") (!= prio "HIGH")))
                        (res_json 400 (dict ("error" "INVALID_PRIORITY") ("valid" "LOW, NORMAL, HIGH")))
                        (let (dep_check (call validate_depends_on (map_get body "depends_on")))
                          (if (!= (map_get dep_check "ok") "true")
                            (res_json 400 (dict
                              ("error" (map_get dep_check "error"))
                              ("reason" (map_get dep_check "reason"))
                              ("field" "depends_on")))
                            (let (deps (map_get dep_check "deps"))
                              (let (n (call next_seq "_seq"))
                                (let (id (str_join (list "HB-" n) ""))
                                  (let (now (time_now))
                                    (let (m (dict
                                          ("id" id)
                                          ("title" title)
                                          ("description" (to_string (map_get body "description")))
                                          ("project" project)
                                          ("priority" prio)
                                          ("risk_level" "LOW")
                                          ("task_class" "unclassified")
                                          ("state" "CREATED")
                                          ("executor" "")
                                          ("outcome" "")
                                          ("provenance" "OPERATOR")
                                          ("depends_on" deps)
                                          ("created_at" now)
                                          ("updated_at" now)
                                          ("reasoning" (dict))
                                          ("authority" (dict ("decision" "REQUIRE_APPROVAL") ("gates" (list))))
                                          ("evidence" (list))
                                          ("plan" (list))
                                          ("execution" (dict))
                                          ("verification" (list))))
                                      (do
                                        (store_open kv "file://howlboard_missions.json")
                                        (store_put kv (str_join (list "mission:" id) "") m)
                                        (call log_event id "task_created" "human_operator" title)
                                        (res_json 201 m)
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/missions/state" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (id (to_string (map_get body "id")))
            (let (to_state (to_string (map_get body "state")))
              (if (or (= id "") (= to_state ""))
                (res_json 400 (dict ("error" "MISSING_FIELD")))
                (do
                  (store_open kv "file://howlboard_missions.json")
                  (let (key (str_join (list "mission:" id) ""))
                    (let (m (store_get kv key))
                      (if (is_nil m)
                        (res_json 404 (dict ("error" "MISSION_NOT_FOUND") ("id" id)))
                        (let (from (to_string (map_get m "state")))
                          (if (= from to_state)
                            (res_json 200 m)
                            (if (call can_transition from to_state)
                              (let (status (call envelope_status m))
                                ; Authority gates execution. A mission may not
                                ; enter EXECUTING without live delegated authority.
                                (if (and (= to_state "EXECUTING") (!= status "DELEGATED_AUTHORITY_ALLOW"))
                                  (res_json 403 (dict
                                    ("error" "AUTHORITY_DENIED")
                                    ("envelope_status" status)
                                    ("id" id)))
                                  (do
                                    (map_set m "state" to_state)
                                    (map_set m "updated_at" (time_now))
                                    (if (= to_state "COMPLETED") (map_set m "outcome" "task_completed") (do))
                                    (if (= to_state "FAILED") (map_set m "outcome" "task_failed") (do))
                                    (if (= to_state "CLOSED") (map_set m "outcome" "task_closed") (do))
                                    (store_put kv key m)
                                    (call log_event id (str_join (list "state:" to_state) "") "control_plane" from)
                                    (res_json 200 m)
                                  )
                                )
                              )
                              (res_json 400 (dict
                                ("error" "INVALID_TRANSITION")
                                ("from" from)
                                ("to" to_state)))
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/missions/approve" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (id (to_string (map_get body "id")))
            (let (approver (to_string (map_get body "approver")))
              (if (or (= id "") (= approver ""))
                (res_json 400 (dict ("error" "MISSING_FIELD")))
                (do
                  (store_open kv "file://howlboard_missions.json")
                  (let (key (str_join (list "mission:" id) ""))
                    (let (m (store_get kv key))
                      (if (is_nil m)
                        (res_json 404 (dict ("error" "MISSION_NOT_FOUND") ("id" id)))
                        (let (auth (map_get m "authority"))
                          (let (ttl (map_get body "ttl_seconds"))
                            (do
                              (if (= ttl "") (set ttl 3600) (do))
                              (map_set auth "approval" (dict
                                ("approver" approver)
                                ("issued_at" (time_now))
                                ("expires_at" (+ (time_now) ttl))))
                              (map_set m "authority" auth)
                              (map_set m "updated_at" (time_now))
                              (store_put kv key m)
                              (call log_event id "human_approval" approver "approval granted")
                              (map_set m "envelope_status" (call envelope_status m))
                              (res_json 200 m)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/missions/reject" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (id (to_string (map_get body "id")))
            (let (approver (to_string (map_get body "approver")))
              (if (or (= id "") (= approver ""))
                (res_json 400 (dict ("error" "MISSING_FIELD")))
                (do
                  (store_open kv "file://howlboard_missions.json")
                  (let (key (str_join (list "mission:" id) ""))
                    (let (m (store_get kv key))
                      (if (is_nil m)
                        (res_json 404 (dict ("error" "MISSION_NOT_FOUND") ("id" id)))
                        (let (auth (map_get m "authority"))
                          (do
                            (map_set auth "decision" "DENY")
                            (map_set auth "reason" (to_string (map_get body "reason")))
                            (map_delete auth "approval")
                            (map_set m "authority" auth)
                            (map_set m "updated_at" (time_now))
                            (store_put kv key m)
                            (call log_event id "human_rejection" approver (to_string (map_get body "reason")))
                            (map_set m "envelope_status" (call envelope_status m))
                            (res_json 200 m)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  (route "/api/missions/delete" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (let (id (to_string (map_get body "id")))
            (if (= id "")
              (res_json 400 (dict ("error" "MISSING_FIELD")))
              (do
                (store_open kv "file://howlboard_missions.json")
                (let (key (str_join (list "mission:" id) ""))
                  (let (m (store_get kv key))
                    (if (is_nil m)
                      (res_json 404 (dict ("error" "MISSION_NOT_FOUND")))
                      (do
                        (store_delete kv key)
                        (call log_event id "task_closed" "human_operator" "mission deleted")
                        (res_json 200 (dict ("status" "deleted") ("id" id)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))

  ; Redacted Factory snapshot. GET and POST {"source":"published"} read the
  ; operator drop. POST {"source":"fixture"} reads the committed fixture.
  ; Missing, invalid, wrong-schema, and non-redacted files degrade to a
  ; present=false body. No supervisor is contacted.
  (route "/api/factory/status" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (if (= (req_method req) "POST")
          (try_let (body (parse_json Any req.body))
            (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
            (call serve_factory_status (to_string (map_get body "source")))
          )
          (call serve_factory_status "published")
        )
      )
    )
  ))

  ; Preview an exact Pending backlog row. Does not write issues.md, bugs.md,
  ; or improvements.md, and does not admit the row itself.
  (route "/api/factory/pending-row" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (body (parse_json Any req.body))
          (catch err (res_json 400 (dict ("error" "INVALID_JSON"))))
          (res_json 200 (call preview_pending_row body))
        )
      )
    )
  ))

  ; Loads demo fixtures. Each fixture carries its own provenance field, so
  ; demo records stay distinguishable from ingested ledger records.
  (route "/api/seed" (lambda (req)
    (do
      (call cors)
      (if (= (req_method req) "OPTIONS")
        (res_json 200 (dict ("status" "ok")))
        (try_let (raw (read_file "data/fixtures/missions.json"))
          (catch err (res_json 500 (dict ("error" "FIXTURES_UNREADABLE"))))
          (let (text (bytes_to_string raw))
          (try_let (doc (parse_json Any text))
            (catch perr (res_json 500 (dict ("error" "FIXTURES_INVALID_JSON"))))
            (let (loaded 0)
              (do
                (store_open kv "file://howlboard_missions.json")
                (for m (map_get doc "missions")
                  (do
                    ; Fixtures declare approval lifetimes relative to load time
                    ; so the expiry demonstration stays truthful as the file ages.
                    (let (auth (map_get m "authority"))
                      (if (= auth "")
                        (do)
                        (let (approval (map_get auth "approval"))
                          (if (= approval "")
                            (do)
                            (let (rel (map_get approval "expires_in"))
                              (if (= rel "")
                                (do)
                                (do
                                  (map_set approval "expires_at" (+ (time_now) (to_int rel)))
                                  (map_delete approval "expires_in")
                                  (map_set auth "approval" approval)
                                  (map_set m "authority" auth)
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                    (store_put kv (str_join (list "mission:" (to_string (map_get m "id"))) "") m)
                    (set loaded (+ loaded 1))
                  )
                )
                (store_open tl "file://howlboard_timeline.json")
                (store_put tl "feed" (dict ("events" (map_get doc "events"))))
                (res_json 200 (dict ("status" "seeded") ("missions" loaded)))
              )
            )
          )
          )
        )
      )
    )
  ))
)
