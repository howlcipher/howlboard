(web_app
  (defun render_task_card (task)
    (type_hint task "dict")
    (let (id (to_string (map_get task "id")))
      (let (title (to_string (map_get task "title")))
        (let (desc (to_string (map_get task "description")))
          (let (prio (to_string (map_get task "priority")))
            (let (labels (to_string (map_get task "labels")))
              (let (status (to_string (map_get task "status")))
                (let (html "")
                  (do
                    (set html (str_join (list "<div class=\"task-card\" id=\"task-" id "\">") ""))
                    (set html (str_join (list html "<div class=\"task-id\">ID_" id "</div>") ""))
                    (set html (str_join (list html "<div class=\"task-title\">" title "</div>") ""))
                    (set html (str_join (list html "<div class=\"task-desc\">" desc "</div>") ""))
                    (set html (str_join (list html "<div class=\"task-meta\"><span>P: " prio "</span><span>L: " labels "</span></div>") ""))
                    (set html (str_join (list html "<div class=\"task-actions\">") ""))
                    (if (= status "BACKLOG")
                      (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'READY')\">-> READY</button>") ""))
                      (do)
                    )
                    (if (= status "READY")
                      (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'IN_PROGRESS')\">-> IN_PROGRESS</button>") ""))
                      (do)
                    )
                    (if (= status "IN_PROGRESS")
                      (do
                        (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'BLOCKED')\">-> BLOCKED</button>") ""))
                        (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'DONE')\">-> DONE</button>") ""))
                      )
                      (do)
                    )
                    (if (= status "BLOCKED")
                      (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'IN_PROGRESS')\">-> IN_PROGRESS</button>") ""))
                      (do)
                    )
                    (if (= status "DONE")
                      (set html (str_join (list html "<button onclick=\"window.change_status('" id "', 'IN_PROGRESS')\">-> REOPEN</button>") ""))
                      (do)
                    )
                    (set html (str_join (list html "<button onclick=\"window.delete_task('" id "')\">DELETE</button>") ""))
                    (set html (str_join (list html "</div></div>") ""))
                    (return html)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun load_tasks ()
    (try_let (resp (fetch "http://localhost:8080/api/tasks" "GET"))
      (catch err
        (set_text (dom_query "#error") "Failed to load tasks")
      )
      (try_let (json_resp (parse_json TaskList resp))
        (catch parse_err
          (set_text (dom_query "#error") "Invalid JSON response")
        )
        (let (tasks (map_get json_resp "tasks"))
          (let (backlog_html "")
            (let (ready_html "")
              (let (inprogress_html "")
                (let (blocked_html "")
                  (let (done_html "")
                    (let (f_search (dom_value (dom_query "#filter-search")))
                      (let (f_status (dom_value (dom_query "#filter-status")))
                        (let (f_prio (dom_value (dom_query "#filter-priority")))
                          (let (f_labels (dom_value (dom_query "#filter-labels")))
                            (do
                              (for task tasks
                                (let (status (to_string (map_get task "status")))
                                  (let (title (to_string (map_get task "title")))
                                    (let (prio (to_string (map_get task "priority")))
                                      (let (labels (to_string (map_get task "labels")))
                                        (let (match true)
                                          (do
                                            (if (and (!= f_search "") (= (regex_match f_search title) false)) (set match false) (do))
                                            (if (and (!= f_status "") (!= f_status status)) (set match false) (do))
                                            (if (and (!= f_prio "") (!= f_prio prio)) (set match false) (do))
                                            (if (and (!= f_labels "") (= (regex_match f_labels labels) false)) (set match false) (do))
                                            (if match
                                              (let (card (call render_task_card task))
                                                (do
                                                  (if (= status "BACKLOG") (set backlog_html (str_join (list backlog_html card) "")) (do))
                                                  (if (= status "READY") (set ready_html (str_join (list ready_html card) "")) (do))
                                                  (if (= status "IN_PROGRESS") (set inprogress_html (str_join (list inprogress_html card) "")) (do))
                                                  (if (= status "BLOCKED") (set blocked_html (str_join (list blocked_html card) "")) (do))
                                                  (if (= status "DONE") (set done_html (str_join (list done_html card) "")) (do))
                                                )
                                              )
                                              (do)
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                              (set_html (dom_query "#tasks-backlog") backlog_html)
                              (set_html (dom_query "#tasks-ready") ready_html)
                              (set_html (dom_query "#tasks-inprogress") inprogress_html)
                              (set_html (dom_query "#tasks-blocked") blocked_html)
                              (set_html (dom_query "#tasks-done") done_html)
                              (set_text (dom_query "#error") "")
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun load_activity ()
    (try_let (resp (fetch "http://localhost:8080/api/activity" "GET"))
      (catch err
        (set_text (dom_query "#error") "Failed to load activity")
      )
      (try_let (json_resp (parse_json ActivityList resp))
        (catch parse_err
          (set_text (dom_query "#error") "Invalid JSON response for activity")
        )
        (let (activities (map_get json_resp "activities"))
          (let (html "")
            (do
              (for act activities
                (let (task_id (to_string (map_get act "task_id")))
                  (let (from (to_string (map_get act "from")))
                    (let (to (to_string (map_get act "to")))
                      (let (ts (to_string (map_get act "timestamp")))
                        (set html (str_join (list html "<div class=\"activity-item\">[" ts "] Task #" task_id ": " from " -> " to "</div>") ""))
                      )
                    )
                  )
                )
              )
              (set_html (dom_query "#activity-list") html)
            )
          )
        )
      )
    )
  )

  (defun add_task ()
    (let (title (dom_value (dom_query "#new-task-title")))
      (let (desc (dom_value (dom_query "#new-task-desc")))
        (let (prio (dom_value (dom_query "#new-task-priority")))
          (let (labels (dom_value (dom_query "#new-task-labels")))
            (if (= title "")
              (set_text (dom_query "#error") "Title cannot be empty")
              (let (req_body (str_join (list "{\"title\":\"" title "\",\"description\":\"" desc "\",\"priority\":\"" prio "\",\"labels\":\"" labels "\"}") ""))
                (try_let (resp (fetch "http://localhost:8080/api/tasks/create" "POST" req_body))
                  (catch err
                    (set_text (dom_query "#error") "Failed to add task")
                  )
                  (do
                    (set_text (dom_query "#error") "")
                    (call load_tasks)
                    (call load_activity)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun change_status (id new_status)
    (type_hint id "string")
    (type_hint new_status "string")
    (let (req_body (str_join (list "{\"id\":\"" id "\",\"status\":\"" new_status "\"}") ""))
      (try_let (resp (fetch "http://localhost:8080/api/tasks/status" "POST" req_body))
        (catch err
          (set_text (dom_query "#error") "Failed to change status")
        )
        (do
          (set_text (dom_query "#error") "")
          (call load_tasks)
          (call load_activity)
        )
      )
    )
  )

  (defun delete_task (id)
    (type_hint id "string")
    (let (req_body (str_join (list "{\"id\":\"" id "\"}") ""))
      (try_let (resp (fetch "http://localhost:8080/api/tasks/delete" "POST" req_body))
        (catch err
          (set_text (dom_query "#error") "Failed to delete task")
        )
        (do
          (set_text (dom_query "#error") "")
          (call load_tasks)
          (call load_activity)
        )
      )
    )
  )

  (on_event (dom_query "#add-btn") "click" (lambda (e)
    (call add_task)
  ))

  (on_event (dom_query "#filter-btn") "click" (lambda (e)
    (call load_tasks)
  ))

  (on_event (dom_query "#activity-btn") "click" (lambda (e)
    (let (drawer (dom_query "#activity-drawer"))
      (do
        (call load_activity)
        (toggle_class drawer "visible")
      )
    )
  ))

  (on_event (dom_query "#theme-toggle") "click" (lambda (e)
    (let (body (dom_query "body"))
      (toggle_class body "light-mode")
    )
  ))

  (export "change_status" change_status)
  (export "delete_task" delete_task)

  (call load_tasks)
  (call load_activity)
)
