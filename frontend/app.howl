; HowlBoard mission control interface.
;
; Compiled through the HowlFrame JavaScript backend to frontend/app.js. Every
; stage of the mission detail view is its own dict-consuming defun, which the
; language only permits because dict parameters and dict returns are annotated
; with type_hint; before that the whole view had to be one expression.

(web_app

  (use "mission_view.howl" as view)

  (defun api_url (path)
    (return (str_join (list "http://localhost:8080" path) ""))
  )

  ; No HTML-escaping primitive exists, so escaping is built from str_split and
  ; str_join. The ampersand pass must run first or the later passes double-encode.








  ; ------------------------------------------------------------ stat header

  (defun render_stats (d)
    (type_hint d "dict")
    (let (counts (map_get d "counts"))
      (let (html "")
        (do
          (set html (str_join (list html
            "<div class=\"stat\"><span class=\"value\">" (to_string (map_get d "total"))
            "</span><span class=\"label\">Missions tracked</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat live\"><span class=\"value\">" (to_string (map_get counts "EXECUTING"))
            "</span><span class=\"label\">Executing</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat warn\"><span class=\"value\">" (to_string (map_get counts "AWAITING_APPROVAL"))
            "</span><span class=\"label\">Awaiting approval</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat\"><span class=\"value\">" (to_string (map_get counts "BLOCKED"))
            "</span><span class=\"label\">Blocked</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat alert\"><span class=\"value\">" (to_string (map_get d "verification_failures"))
            "</span><span class=\"label\">Verification failures</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat alert\"><span class=\"value\">" (to_string (map_get d "expired_authority"))
            "</span><span class=\"label\">Expired authority</span></div>") ""))
          (set html (str_join (list html
            "<div class=\"stat\"><span class=\"value\">" (to_string (map_get counts "COMPLETED"))
            "</span><span class=\"label\">Completed</span></div>") ""))
          (return html)
        )
      )
    )
  )

  ; Factory status is a projection. Missing snapshots render as unknown.

  (defun none (s)
    (let (text (to_string s))
      (let (out "none")
        (do
          (if (= text "") (do) (set out (call view/esc text)))
          (return out)
        )
      )
    )
  )

  (defun blocker_class (cls)
    (let (css "blocker")
      (do
        (if (= cls "OWNER_REQUIRED") (set css "blocker blocker-owner") (do))
        (if (= cls "BLOCKED") (set css "blocker blocker-blocked") (do))
        (if (= cls "DEFERRED") (set css "blocker blocker-deferred") (do))
        (return css)
      )
    )
  )

  (defun render_factory (d)
    (type_hint d "dict")
    (let (err (to_string (map_get d "error")))
      (let (html "")
        (do
          (if (= err "")
            (do)
            (return (str_join (list "<p class=\"empty\">" (call view/esc err) "</p>") ""))
          )
          (let (prov (to_string (map_get d "provenance")))
            (let (reason (to_string (map_get d "reason")))
              (let (prov_class "prov")
              (do
                (if (= prov "PUBLISHED") (set prov_class "prov prov-PUBLISHED") (do))
                (if (= prov "FIXTURE") (set prov_class "prov prov-FIXTURE") (do))
                (if (= prov "ABSENT") (set prov_class "prov prov-ABSENT") (do))
                (if (= prov "INVALID") (set prov_class "prov prov-INVALID") (do))
                (set html (str_join (list
                  "<span class=\"" prov_class "\">" (call view/esc prov) "</span>") ""))
                (if (= (map_get d "present") "true")
                  (do
                    (set html (str_join (list html
                      "<p class=\"item-sub\">Projection of <code>howlplane.factory.status/v1</code> from Plane artifact <code>factory/status/remote-snapshot.json</code>. Not an authority grant.</p>"
                      "<dl class=\"kv\">"
                      "<dt>Campaign</dt><dd>" (call none (map_get d "campaign_id")) "</dd>"
                      "<dt>Mission campaign</dt><dd>" (call none (map_get d "mission_campaign_id")) "</dd>"
                      "<dt>Repository</dt><dd>" (call none (map_get d "repository")) "</dd>"
                      "<dt>State</dt><dd>" (call none (map_get d "state")) "</dd>"
                      "<dt>Dispatch</dt><dd>" (call none (map_get d "current_dispatch")) "</dd>"
                      "<dt>Work item</dt><dd>" (call none (map_get d "current_work_item_id")) "</dd>"
                      "<dt>Owner required</dt><dd>" (call none (map_get d "owner_required")) "</dd>"
                      "<dt>Last tick</dt><dd>" (call none (map_get d "last_tick_at")) "</dd>"
                      "<dt>Last error</dt><dd>" (call none (map_get d "last_error")) "</dd>"
                      "<dt>Failures</dt><dd>" (call none (map_get d "failure_count")) "</dd>"
                      "<dt>Authority</dt><dd>" (call none (map_get d "authority")) "</dd>"
                      "<dt>Objective</dt><dd>" (call none (map_get d "objective")) "</dd>"
                      "<dt>Published</dt><dd>" (call none (map_get d "published_at")) "</dd>"
                      "</dl><h3>Blockers</h3>") ""))
                    (let (n 0)
                      (do
                        (for b (map_get d "blockers")
                          (let (cls (to_string (map_get b "class")))
                            (do
                              (set n (+ n 1))
                              (set html (str_join (list html
                                "<div class=\"" (call blocker_class cls) "\">"
                                "<span class=\"state\">" (call view/esc cls) "</span>"
                                "<span>" (call none (map_get b "summary")) "</span>"
                                "<div class=\"item-sub\">" (call none (map_get b "work_item_id"))
                                " " (call none (map_get b "state"))
                                " " (call none (map_get b "proposal_id")) "</div></div>") ""))
                            )
                          )
                        )
                        (if (= n 0)
                          (set html (str_join (list html "<p class=\"empty\">No blockers in the snapshot.</p>") ""))
                          (do)
                        )
                      )
                    )
                  )
                  (do
                    (set html (str_join (list html "<p class=\"empty\">") ""))
                    (if (= reason "SNAPSHOT_ABSENT")
                      (set html (str_join (list html
                        "Factory status is unknown. Plane has not published <code>factory/status/remote-snapshot.json</code> into the Board drop at <code>"
                        (call view/esc (map_get d "projection_path"))
                        "</code>. Nothing was started.") ""))
                      (do)
                    )
                    (if (= reason "SNAPSHOT_INVALID")
                      (set html (str_join (list html "The snapshot file is not valid JSON. Status stays unknown.") ""))
                      (do)
                    )
                    (if (= reason "SCHEMA_MISMATCH")
                      (set html (str_join (list html "The file is not schema <code>howlplane.factory.status/v1</code>, so it was not displayed.") ""))
                      (do)
                    )
                    (if (= reason "NOT_REDACTED")
                      (set html (str_join (list html "The file is not marked redacted. HowlBoard refused to display it.") ""))
                      (do)
                    )
                    (if (= reason "")
                      (set html (str_join (list html "Factory status is unknown.") ""))
                      (do)
                    )
                    (set html (str_join (list html "</p>") ""))
                  )
                )
                (if (= prov "FIXTURE")
                  (set html (str_join (list html
                    "<p class=\"factory-note\">Fixture preview. This is not a snapshot published by the Factory host.</p>") ""))
                  (do)
                )
                (return html)
              )
            )
            )
          )
        )
      )
    )
  )

  (defun render_pending (d)
    (type_hint d "dict")
    (let (html "")
      (do
        (if (= (map_get d "eligible") "true")
          (set html "<p class=\"eligible-yes\">Eligible. BacklogSource would admit this exact Pending row as existing_backlog.</p>")
          (set html "<p class=\"eligible-no\">Not eligible yet. The preview did not admit anything.</p>")
        )
        (let (reasons (map_get d "reasons"))
          (do
            (if (= (to_string reasons) "")
              (do)
              (do
                (set html (str_join (list html "<ul>") ""))
                (for reason reasons
                  (set html (str_join (list html "<li>" (call view/esc reason) "</li>") ""))
                )
                (set html (str_join (list html "</ul>") ""))
              )
            )
            (if (= (to_string (map_get d "markdown")) "")
              (do)
              (set html (str_join (list html
                "<pre class=\"pending-preview\">" (call view/esc (map_get d "markdown")) "</pre>") ""))
            )
            (set html (str_join (list html
              "<p class=\"factory-note\">" (call view/esc (map_get d "note")) "</p>") ""))
            (return html)
          )
        )
      )
    )
  )

  ; --------------------------------------------------------- mission list



  ; ------------------------------------------------- mission detail spine















  ; A "claimed" result is an assertion the agent made that nothing independently
  ; confirmed. It is rendered as its own status, never folded into "passed".








  ; ------------------------------------------------------------- data loads

  (defun show_error (msg)
    (type_hint return "void")
    (set_text (dom_query "#error") msg)
  )

  (defun load_dashboard ()
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/dashboard") "GET"))
      (catch err (call show_error "Cannot reach the mission API on port 8080."))
      (try_let (d (parse_json Any raw))
        (catch perr (call show_error "Dashboard response was not valid JSON."))
        (set_html (dom_query "#stats") (call render_stats d))
      )
    )
  )

  (defun load_projects ()
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/projects") "GET"))
      (catch err (do))
      (try_let (d (parse_json Any raw))
        (catch perr (do))
        (let (projects (map_get d "projects"))
          (let (html "")
            (let (options "<option value=\"\">All workstreams</option>")
              (do
                (for row projects
                  (let (name (to_string (map_get row "name")))
                    (do
                      (set html (str_join (list html
                        "<span class=\"project-chip\">" (call view/esc name)
                        "<span class=\"count\">" (to_string (map_get row "count")) "</span></span>") ""))
                      (set options (str_join (list options
                        "<option value=\"" (call view/esc name) "\">" (call view/esc name) "</option>") ""))
                    )
                  )
                )
                (set_html (dom_query "#projects") html)
                (set_html (dom_query "#filter-project") options)
              )
            )
          )
        )
      )
    )
  )

  (defun load_missions ()
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/missions") "GET"))
      (catch err (call show_error "Cannot reach the mission API on port 8080."))
      (try_let (d (parse_json Any raw))
        (catch perr (call show_error "Mission list response was not valid JSON."))
        (let (want_state (dom_value (dom_query "#filter-state")))
          (let (want_project (dom_value (dom_query "#filter-project")))
            (let (html "")
              (let (shown 0)
                (do
                  (call show_error "")
                  (for m (map_get d "missions")
                    (let (keep true)
                      (do
                        (if (= want_state "")
                          (do)
                          (if (= (to_string (map_get m "state")) want_state) (do) (set keep false))
                        )
                        (if (= want_project "")
                          (do)
                          (if (= (to_string (map_get m "project")) want_project) (do) (set keep false))
                        )
                        (if keep
                          (do
                            (set html (str_join (list html (call view/render_row m)) ""))
                            (set shown (+ shown 1))
                          )
                          (do)
                        )
                      )
                    )
                  )
                  (if (= shown 0)
                    (set_html (dom_query "#mission-list")
                      "<p class=\"empty\">No missions match. Load the demo missions to populate the board.</p>")
                    (set_html (dom_query "#mission-list") html)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun load_feed ()
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/timeline") "GET"))
      (catch err (do))
      (try_let (d (parse_json Any raw))
        (catch perr (do))
        (let (html "<div class=\"timeline\">")
          (do
            (for e (map_get d "events")
              (set html (str_join (list html
                "<div class=\"timeline-row\"><span class=\"at\">" (call view/ago (map_get e "timestamp"))
                "</span><span><span class=\"what\">" (call view/esc (map_get e "action"))
                "</span><span class=\"who\"> " (call view/esc (map_get e "actor"))
                " &middot; " (call view/esc (map_get e "mission_id")) "</span></span></div>") ""))
            )
            (set_html (dom_query "#feed") (str_join (list html "</div>") ""))
          )
        )
      )
    )
  )

  (defun open_mission (id)
    (type_hint return "void")
    ; Lookup body via encode_json — never string-concatenate JSON around the id.
    (try_let (raw (fetch (call api_url "/api/missions/get") "POST" (encode_json (dict ("id" id)))))
      (catch err (call show_error "Cannot load that mission."))
      (try_let (m (parse_json Any raw))
        (catch perr (call show_error "Mission response was not valid JSON."))
        (do
          (let (err_code (to_string (map_get m "error")))
            (if (= err_code "")
              (do
                (call show_error "")
                (let (html (call view/render_detail m))
                  (do
                    (let (mid (call view/esc (map_get m "id")))
                      (set html (str_join (list html
                        "<div class=\"stage\"><div class=\"actions\">"
                        "<button type=\"button\" data-mission-id=\"" mid "\""
                        " onclick=\"window.approve_mission(this.dataset.missionId)\">Grant approval</button>"
                        "<button type=\"button\" data-mission-id=\"" mid "\""
                        " onclick=\"window.reject_mission(this.dataset.missionId)\">Reject</button>"
                        "<button type=\"button\" data-mission-id=\"" mid "\""
                        " onclick=\"window.advance_mission(this.dataset.missionId)\">Advance to EXECUTING</button>"
                        "</div></div>") ""))
                    )
                    (set_html (dom_query "#mission-detail") html)
                    (set_text (dom_query "#detail-heading") (str_join (list "Mission detail / " id) ""))
                  )
                )
              )
              (do
                ; Honest missing/unknown target — never silent no-op.
                (call show_error (str_join (list "Mission not found: " id) ""))
                (set_html (dom_query "#mission-detail")
                  (str_join (list "<p class=\"item-sub\">Mission not found.</p>") ""))
                (set_text (dom_query "#detail-heading") (str_join (list "Mission detail / " id) ""))
              )
            )
          )
        )
      )
    )
  )

  (defun load_factory (source)
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/factory/status") "POST" (encode_json (dict ("source" source)))))
      (catch err (set_html (dom_query "#factory-status")
        "<p class=\"empty\">Factory status API is unreachable. Nothing was started.</p>"))
      (try_let (d (parse_json Any raw))
        (catch perr (set_html (dom_query "#factory-status")
          "<p class=\"empty\">Factory status response was not valid JSON.</p>"))
        (set_html (dom_query "#factory-status") (call render_factory d))
      )
    )
  )

  (defun preview_pending ()
    (type_hint return "void")
    (let (payload (encode_json (dict
          ("item_id" (dom_value (dom_query "#pending-item-id")))
          ("title" (dom_value (dom_query "#pending-title")))
          ("score" (dom_value (dom_query "#pending-score")))
          ("formula" (dom_value (dom_query "#pending-formula")))
          ("rationale" (dom_value (dom_query "#pending-rationale")))
          ("source_file" (dom_value (dom_query "#pending-source")))
          ("symptom" (dom_value (dom_query "#pending-symptom")))
          ("acceptance" (dom_value (dom_query "#pending-acceptance"))))))
      (try_let (raw (fetch (call api_url "/api/factory/pending-row") "POST" payload))
        (catch err (set_html (dom_query "#pending-preview")
          "<p class=\"empty\">Pending preview could not reach the mission API.</p>"))
        (try_let (d (parse_json Any raw))
          (catch perr (set_html (dom_query "#pending-preview")
            "<p class=\"empty\">Pending preview response was not valid JSON.</p>"))
          (set_html (dom_query "#pending-preview") (call render_pending d))
        )
      )
    )
  )

  (defun refresh_all ()
    (type_hint return "void")
    (do
      (call load_dashboard)
      (call load_projects)
      (call load_missions)
      (call load_feed)
      (call load_factory "published")
    )
  )

  (defun approve_mission (id)
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/missions/approve") "POST"
        (str_join (list "{\"id\":\"" id "\",\"approver\":\"human_operator\",\"ttl_seconds\":3600}") "")))
      (catch err (call show_error "Approval request failed."))
      (do
        (call refresh_all)
        (call open_mission id)
      )
    )
  )

  (defun reject_mission (id)
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/missions/reject") "POST"
        (str_join (list "{\"id\":\"" id "\",\"approver\":\"human_operator\",\"reason\":\"rejected from mission control\"}") "")))
      (catch err (call show_error "Rejection request failed."))
      (do
        (call refresh_all)
        (call open_mission id)
      )
    )
  )

  (defun advance_mission (id)
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/missions/state") "POST"
        (str_join (list "{\"id\":\"" id "\",\"state\":\"EXECUTING\"}") "")))
      (catch err (call show_error "State change failed."))
      (try_let (d (parse_json Any raw))
        (catch perr (call show_error "State response was not valid JSON."))
        (do
          (let (e (to_string (map_get d "error")))
            (if (= e "")
              (call show_error "")
              (call show_error (str_join (list e " - " (to_string (map_get d "envelope_status"))) ""))
            )
          )
          (call refresh_all)
          (call open_mission id)
        )
      )
    )
  )

  (defun seed_board ()
    (type_hint return "void")
    (try_let (raw (fetch (call api_url "/api/seed") "POST" "{}"))
      (catch err (call show_error "Could not load demo missions."))
      (call refresh_all)
    )
  )

  ; ----------------------------------------------------------------- wiring

  (on_event (dom_query "#seed-btn") "click" (lambda (e) (call seed_board)))
  (on_event (dom_query "#refresh-btn") "click" (lambda (e) (call refresh_all)))
  (on_event (dom_query "#factory-refresh") "click" (lambda (e) (call load_factory "published")))
  (on_event (dom_query "#factory-fixture") "click" (lambda (e) (call load_factory "fixture")))
  (on_event (dom_query "#pending-preview-btn") "click" (lambda (e) (call preview_pending)))
  (on_event (dom_query "#filter-state") "change" (lambda (e) (call load_missions)))
  (on_event (dom_query "#filter-project") "change" (lambda (e) (call load_missions)))
  (on_event (dom_query "#theme-toggle") "click" (lambda (e)
    (toggle_class (dom_query "body") "light-mode")))

  (export "open_mission" open_mission)
  (export "approve_mission" approve_mission)
  (export "reject_mission" reject_mission)
  (export "advance_mission" advance_mission)

  (call refresh_all)
)
