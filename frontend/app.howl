(web_app
  (defun render_tasks (tasks)
    (let (output "")
      (do
        (for task tasks
          (let (id (map_get task "id"))
            (let (title (map_get task "title"))
              (let (status (map_get task "status"))
                (set output (str_join (list output "#" id " - " title " (" status ")\n") ""))
              )
            )
          )
        )
        (set_text (dom_query "#tasks") output)
      )
    )
  )

  (defun show_error (message)
    (set_text (dom_query "#error") message)
  )

  (defun load_tasks ()
    (try_let (response (fetch "http://localhost:8080/api/tasks" "GET"))
      (catch fetch_error
        (call show_error "Unable to load tasks. Is the backend running?")
      )
      (try_let (payload (parse_json TaskList response))
        (catch parse_error
          (call show_error "The task service returned an invalid response.")
        )
        (let (tasks (map_get payload "tasks"))
          (do
            (set_text (dom_query "#error") "")
            (call render_tasks tasks)
          )
        )
      )
    )
  )

  (defun create_task ()
    (let (title (dom_value (dom_query "#new-task-title")))
      (if (regex_match "^[A-Za-z0-9 .,!?'-]+$" title)
        (let (body (str_join (list "{\"title\":\"" title "\"}") ""))
          (try_let (response (fetch "http://localhost:8080/api/tasks" "POST" body))
            (catch fetch_error
              (call show_error "Unable to create the task. Is the backend running?")
            )
            (try_let (task (parse_json Task response))
              (catch parse_error
                (call show_error "The task service rejected the new task.")
              )
              (if (!= (map_get task "error") "")
                (call show_error (map_get task "error"))
                (do
                  (set_text (dom_query "#new-task-title") "")
                  (call load_tasks)
                )
              )
            )
          )
        )
        (call show_error "Use letters, numbers, spaces, and basic punctuation for the title.")
      )
    )
  )

  (defun complete_task ()
    (let (id (dom_value (dom_query "#task-id")))
      (if (regex_match "^[0-9]+$" id)
        (let (body (str_join (list "{\"id\":\"" id "\"}") ""))
          (try_let (response (fetch "http://localhost:8080/api/tasks/complete" "POST" body))
            (catch fetch_error
              (call show_error "Unable to update the task. Is the backend running?")
            )
            (try_let (task (parse_json Task response))
              (catch parse_error
                (call show_error "The task service rejected the update.")
              )
              (if (!= (map_get task "error") "")
                (call show_error (map_get task "error"))
                (call load_tasks)
              )
            )
          )
        )
        (call show_error "Enter a numeric task ID to mark it complete.")
      )
    )
  )

  (on_event (dom_query "#load-btn") "click" (lambda (event)
    (call load_tasks)
  ))
  (on_event (dom_query "#create-btn") "click" (lambda (event)
    (call create_task)
  ))
  (on_event (dom_query "#complete-btn") "click" (lambda (event)
    (call complete_task)
  ))
  (call load_tasks)
)
