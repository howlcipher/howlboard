(web_app
  (defun format_task (task)
    (type_hint task "dict")
    (let (id (to_string (map_get task "id")))
      (let (title (to_string (map_get task "title")))
        (let (status (to_string (map_get task "status")))
          (return (+ id (+ " - " (+ title (+ " (" (+ status ")\n"))))))
        )
      )
    )
  )

  (defun load_tasks ()
    (try_let (resp (fetch "http://localhost:8080/api/tasks" "GET"))
      (catch err
        (set_text (dom_query "#error") "Failed to load tasks")
      )
      (try_let (json_resp (parse_json TaskList resp))
        (catch parse_err
          (set_text (dom_query "#error") "Invalid JSON response")
        )
        (let (tasks (map_get json_resp "tasks"))
          (let (display "")
            (do
              (for task tasks
                (let (f (call format_task task))
                  (set display (+ display f))
                )
              )
              (set_text (dom_query "#tasks-display") display)
              (set_text (dom_query "#error") "")
            )
          )
        )
      )
    )
  )

  (defun add_task ()
    (let (title_input (dom_query "#new-task-title"))
      (let (title (dom_value title_input))
        (if (= title "")
          (set_text (dom_query "#error") "Title cannot be empty")
          (let (req_body (+ "{\"title\":\"" (+ title "\"}")))
            (try_let (resp (fetch "http://localhost:8080/api/tasks/create" "POST" req_body))
              (catch err
                (set_text (dom_query "#error") "Failed to add task")
              )
              (do
                (set_text (dom_query "#error") "")
                (call load_tasks)
              )
            )
          )
        )
      )
    )
  )

  (defun complete_task ()
    (let (id_input (dom_query "#complete-task-id"))
      (let (id (dom_value id_input))
        (if (= id "")
          (set_text (dom_query "#error") "ID cannot be empty")
          (let (req_body (+ "{\"id\":\"" (+ id "\"}")))
            (try_let (resp (fetch "http://localhost:8080/api/tasks/complete" "POST" req_body))
              (catch err
                (set_text (dom_query "#error") "Failed to complete task")
              )
              (do
                (set_text (dom_query "#error") "")
                (call load_tasks)
              )
            )
          )
        )
      )
    )
  )

  (on_event (dom_query "#load-btn") "click" (lambda (e)
    (call load_tasks)
  ))

  (on_event (dom_query "#add-btn") "click" (lambda (e)
    (call add_task)
  ))

  (on_event (dom_query "#complete-btn") "click" (lambda (e)
    (call complete_task)
  ))
)
