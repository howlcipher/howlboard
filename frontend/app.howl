(web_app
  (defun render_task_card (task)
    (type_hint task "dict")
    (let (id (to_string (map_get task "id")))
      (let (title (to_string (map_get task "title")))
        (let (desc (to_string (map_get task "description")))
          (let (prio (to_string (map_get task "priority")))
            (let (tags (to_string (map_get task "tags")))
              (let (status (to_string (map_get task "status")))
                (let (html (+ "<div class=\"task-card\" id=\"task-" (+ id "\">")))
                  (do
                    (set html (+ html (+ "<div class=\"task-id\">ID_" (+ id "</div>"))))
                    (set html (+ html (+ "<div class=\"task-title\">" (+ title "</div>"))))
                    (set html (+ html (+ "<div class=\"task-desc\">" (+ desc "</div>"))))
                    (set html (+ html (+ "<div class=\"task-meta\"><span>P: " (+ prio (+ "</span><span>T: " (+ tags "</span></div>"))))))
                    (set html (+ html "<div class=\"task-actions\">"))
                    (if (= status "BACKLOG")
                      (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'READY')\">-> READY</button>"))))
                      (do)
                    )
                    (if (= status "READY")
                      (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'IN_PROGRESS')\">-> IN_PROGRESS</button>"))))
                      (do)
                    )
                    (if (= status "IN_PROGRESS")
                      (do
                        (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'BLOCKED')\">-> BLOCKED</button>"))))
                        (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'DONE')\">-> DONE</button>"))))
                      )
                      (do)
                    )
                    (if (= status "BLOCKED")
                      (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'IN_PROGRESS')\">-> IN_PROGRESS</button>"))))
                      (do)
                    )
                    (if (= status "DONE")
                      (set html (+ html (+ "<button onclick=\"window.change_status('" (+ id "', 'IN_PROGRESS')\">-> REOPEN</button>"))))
                      (do)
                    )
                    (set html (+ html (+ "<button onclick=\"window.delete_task('" (+ id "')\">DELETE</button>"))))
                    (set html (+ html "</div></div>"))
                    (return html)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun load_tasks ()
    (try_let (resp (fetch "http://localhost:8080/api/tasks" "GET"))
      (catch err
        (set_text (dom_query "#error") "Failed to load tasks")
      )
      (try_let (json_resp (parse_json TaskList resp))
        (catch parse_err
          (set_text (dom_query "#error") "Invalid JSON response")
        )
        (let (tasks (map_get json_resp "tasks"))
          (let (backlog_html "")
            (let (ready_html "")
              (let (inprogress_html "")
                (let (blocked_html "")
                  (let (done_html "")
                    (do
                      (for task tasks
                        (let (status (to_string (map_get task "status")))
                          (let (card (call render_task_card task))
                            (do
                              (if (= status "BACKLOG") (set backlog_html (+ backlog_html card)) (do))
                              (if (= status "READY") (set ready_html (+ ready_html card)) (do))
                              (if (= status "IN_PROGRESS") (set inprogress_html (+ inprogress_html card)) (do))
                              (if (= status "BLOCKED") (set blocked_html (+ blocked_html card)) (do))
                              (if (= status "DONE") (set done_html (+ done_html card)) (do))
                            )
                          )
                        )
                      )
                      (set_html (dom_query "#tasks-backlog") backlog_html)
                      (set_html (dom_query "#tasks-ready") ready_html)
                      (set_html (dom_query "#tasks-inprogress") inprogress_html)
                      (set_html (dom_query "#tasks-blocked") blocked_html)
                      (set_html (dom_query "#tasks-done") done_html)
                      (set_text (dom_query "#error") "")
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun add_task ()
    (let (title (dom_value (dom_query "#new-task-title")))
      (let (desc (dom_value (dom_query "#new-task-desc")))
        (let (prio (dom_value (dom_query "#new-task-priority")))
          (let (tags (dom_value (dom_query "#new-task-tags")))
            (if (= title "")
              (set_text (dom_query "#error") "Title cannot be empty")
              (let (req_body (+ "{\"title\":\"" (+ title (+ "\",\"description\":\"" (+ desc (+ "\",\"priority\":\"" (+ prio (+ "\",\"tags\":\"" (+ tags "}")))))))))
                (try_let (resp (fetch "http://localhost:8080/api/tasks/create" "POST" req_body))
                  (catch err
                    (set_text (dom_query "#error") "Failed to add task")
                  )
                  (do
                    (set_text (dom_query "#error") "")
                    (call load_tasks)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

  (defun change_status (id new_status)
    (type_hint id "string")
    (type_hint new_status "string")
    (let (req_body (+ "{\"id\":\"" (+ id (+ "\",\"status\":\"" (+ new_status "\"}")))))
      (try_let (resp (fetch "http://localhost:8080/api/tasks/status" "POST" req_body))
        (catch err
          (set_text (dom_query "#error") "Failed to change status")
        )
        (do
          (set_text (dom_query "#error") "")
          (call load_tasks)
        )
      )
    )
  )

  (defun delete_task (id)
    (type_hint id "string")
    (let (req_body (+ "{\"id\":\"" (+ id "\"}")))
      (try_let (resp (fetch "http://localhost:8080/api/tasks/delete" "POST" req_body))
        (catch err
          (set_text (dom_query "#error") "Failed to delete task")
        )
        (do
          (set_text (dom_query "#error") "")
          (call load_tasks)
        )
      )
    )
  )

  (on_event (dom_query "#add-btn") "click" (lambda (e)
    (call add_task)
  ))

  (on_event (dom_query "#theme-toggle") "click" (lambda (e)
    (let (body (dom_query "body"))
      (toggle_class body "light-mode")
    )
  ))

  (export "change_status" change_status)
  (export "delete_task" delete_task)

  (call load_tasks)
)
