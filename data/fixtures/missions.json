    {
      "id": "HF-412",
      "title": "Reject unknown opcodes in bytecode UnmarshalJSON",
      "description": "Malformed .hfbc payloads decoded into an opcode value with no registry entry, so a corrupt artifact reached the VM dispatch loop instead of being refused at parse time.",
      "project": "HowlFrame",
      "priority": "HIGH",
      "risk_level": "MEDIUM",
      "task_class": "bug_fix",
      "state": "COMPLETED",
      "executor": "claude_code",
      "recommended_executor": "claude_code",
      "is_override": false,
      "outcome": "task_completed",
      "provenance": "DEMO",
      "created_at": 1788786452,
      "updated_at": 1788793652,
      "reasoning": {
        "problem": "bytecode.UnmarshalJSON accepted any integer as an opcode, so a truncated or hand-edited .hfbc reached the VM and failed deep in dispatch with an opaque VM_INTERNAL error.",
        "observations": [
          "Registry lookup happens at dispatch, not at decode.",
          "A fuzzed artifact with opcode 9999 produced VM_INTERNAL with no source location.",
          "internal/bytecode/bytecode.go had no validation in the UnmarshalJSON path."
        ],
        "assumptions": [
          "Every legitimate opcode is present in bytecode.Registry at decode time.",
          "No caller depends on decoding a forward-compatible unknown opcode."
        ],
        "options": [
          {
            "option": "Validate at decode and reject unknown opcodes",
            "assessment": "Fails closed at the trust boundary; smallest change."
          },
          {
            "option": "Validate lazily at dispatch with a better error",
            "assessment": "Keeps a corrupt program alive until execution; rejected."
          },
          {
            "option": "Version the bytecode format and skip unknown opcodes",
            "assessment": "Forward compatibility is not a current requirement; adds surface area."
          }
        ],
        "selected": "Validate at decode and reject unknown opcodes",
        "rationale": "The artifact boundary is where a malformed program should be refused. Rejecting at decode keeps the failure close to its cause and preserves the fail-closed contract.",
        "confidence": "high",
        "decided_by": "claude_code"
      },
      "authority": {
