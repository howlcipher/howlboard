      "provenance": "DEMO",
      "created_at": 1789024052,
      "updated_at": 1789043252,
      "reasoning": {
        "problem": "Approval.expires_at is fixed at one hour. A staged production rollout routinely exceeds that, so operators re-approve mid-flight and the approval stops being a meaningful bound.",
        "observations": [
          "Approval carries issued_at, expires_at, and a nonce, but no configurable TTL.",
          "Three of the last five production rollouts required a second approval.",
          "Re-approval reuses the same decision digest, so it is indistinguishable from the first."
        ],
        "assumptions": [
          "Longer TTLs remain acceptable only when scoped to a single decision digest."
        ],
        "options": [
          {
            "option": "Make TTL a per-action-class policy value",
            "assessment": "Scoped and auditable; needs human sign-off because it widens an authority bound."
          },
          {
            "option": "Raise the global TTL to six hours",
            "assessment": "Simple, but widens authority for every action class indiscriminately."
          },
          {
            "option": "Allow unlimited re-approval",
            "assessment": "Removes the bound entirely; rejected."
          }
        ],
        "selected": "Make TTL a per-action-class policy value",
        "rationale": "Widening an authority boundary is exactly the class of change that must not be autonomous. The narrow option is proposed and held for a human.",
